---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_items = site.pages | concat: site.posts | concat: site.fellows | concat: site.positions %}
  {% for item in sitemap_items %}
    {% unless item.sitemap == false or item.sitemap.exclude == "yes" or item.url == nil %}
    <url>
      <loc>{{ item.url | absolute_url }}</loc>
      {% if item.last_reviewed %}<lastmod>{{ item.last_reviewed | date: "%Y-%m-%d" }}</lastmod>{% elsif item.last_modified_at %}<lastmod>{{ item.last_modified_at | date: "%Y-%m-%d" }}</lastmod>{% elsif item.date %}<lastmod>{{ item.date | date: "%Y-%m-%d" }}</lastmod>{% endif %}
    </url>
    {% endunless %}
  {% endfor %}
</urlset>
