---
import { site, plainText, structuredData } from '../lib/content.mjs';
const { page } = Astro.props;
const title=page.title===site.title?site.title:`${page.title} · ${site.title}`;
const description=plainText(page.description||site.description);
const canonical=new URL(page.url,site.url),image=new URL(page.featured_image||'/assets/img/home-banner.webp',site.url);
const json=structuredData(page);
---
<meta name="author" content="James P. Howard, II" />
<meta name="generator" content="Astro" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/assets/img/identity/favicon.svg" type="image/svg+xml" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.title} /><meta property="og:image" content={image} /><meta property="og:locale" content="en_US" /><meta property="og:type" content={page.kind==='post'?'article':'website'} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} /><meta name="fediverse:creator" content="@krigsvold@mastodon.social" />
<link rel="me" href="https://mastodon.social/@krigsvold" />
<link rel="alternate" type="application/atom+xml" title={site.title} href="/feed.xml" />
<link rel="stylesheet" href="/assets/css/material-kit.css?v=3.0.4" />
<link rel="stylesheet" href="/assets/css/gdpr-cookie.css" />
{json && <script type="application/ld+json" is:inline set:html={JSON.stringify(json).replace(/</g,'\\u003c')} />}
