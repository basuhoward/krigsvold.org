{
  "name": "krigsvold-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "prepare": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare && astro dev",
    "build": "npm run prepare && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "check": "npm run prepare && astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm test && npm run build && node scripts/validate-build.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@krigsvold/theme": "2.0.0",
    "@krigsvold/astro": "1.0.0",
    "astro": "7.3.2",
    "markdown-it": "15.0.3",
    "yaml": "2.9.1",
    "fuse.js": "7.5.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "playwright": "1.64.1",
    "axe-core": "4.10.3"
  }
}
